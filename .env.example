# App: runtime environment and log verbosity
ENV=dev
LOG_LEVEL=INFO

# Data: source documents, generated output, document/user metadata and the eval set
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
PARSED_DOCUMENTS_PATH=data/processed/documents.jsonl
DATA_METADATA_DIR=data/metadata
EVAL_SET_PATH=eval/eval_set.jsonl

# LLM and embeddings: one provider (gemini or openai) serves chat and embeddings
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MAX_RETRIES=5

# Secrets: API keys, only in your local .env, never committed
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Vector store: backend, local storage path and collection name
VECTOR_DB=chroma
VECTOR_DB_PATH=chroma_db
VECTOR_COLLECTION=askwell_structured

# Chunking and retrieval: strategy (structure or fixed), chunk size/overlap in characters,
# chunks retrieved per question
CHUNK_STRATEGY=structure
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5

# Retrieval mode: dense, bm25 or hybrid; hybrid fusion: candidates per list, RRF constant,
# BM25 weight (dense weight is 1.0)
RETRIEVAL_MODE=hybrid
HYBRID_CANDIDATES=20
RRF_K=60
BM25_WEIGHT=0.3

# Reranking: cross-encoder or none; Hugging Face model, pinned commit, ONNX file in the repo,
# first-stage candidates rescored per question, local model cache
RERANKER=cross-encoder
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MODEL_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
RERANK_ONNX_FILE=onnx/model.onnx
RERANK_CANDIDATES=40
RERANK_MODEL_DIR=.cache/models

# Version policy: active_only (drop superseded documents), prefer_active (rank them below the
# active version) or all
VERSION_POLICY=active_only

# Answers: grounded (cited, refuses when evidence is weak) or baseline (minimal prompt);
# refusal gate: refuse without an LLM call if the top reranker score is below this
# (REFUSAL_MIN_SCORE=none disables it; it is skipped when RERANKER=none)
ANSWER_MODE=grounded
REFUSAL_MIN_SCORE=-4.0

# Role-based access: restrict every retrieval to what the X-User-Id user may read
# (false = no access filtering, for eval comparison and legacy tests)
RBAC_ENABLED=true

# Conversation memory: per-session history and follow-up rewriting (false = ignore session_id)
MEMORY_ENABLED=true
MEMORY_MAX_TURNS=10
MEMORY_REWRITE_TURNS=4
MEMORY_MAX_SESSIONS=1000
MEMORY_TTL_SECONDS=3600

# Prompt-injection defense: sanitize questions and retrieved text, isolate them in the prompt,
# guard the output (false = the exact pre-Phase-13 prompts, for eval comparison)
INJECTION_DEFENSE=true
MAX_QUESTION_CHARS=2000

# Caching: query embeddings, retrieval results and answers (false = no caching). Entries are
# keyed by user, filters, settings, versions and the index fingerprint; the TTL is a safety net.
CACHE_ENABLED=true
CACHE_EMBEDDING_ENTRIES=2048
CACHE_RETRIEVAL_ENTRIES=512
CACHE_ANSWER_ENTRIES=256
CACHE_TTL_SECONDS=3600
# Cache backend: memory (in-process, default) or redis (shared, survives restarts). With redis
# every layer gets its own prefix under REDIS_KEY_PREFIX (askwell:embeddings:, ...); any Redis
# error is just a cache miss. docker compose sets CACHE_BACKEND=redis and REDIS_URL for you.
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=askwell:

# Tracing: a structured trace per chat/ingest request (stages, latency, tokens, cache status),
# kept in memory (ring buffer) and appended to traces/traces-YYYY-MM-DD.jsonl. Text is not stored
# unless TRACE_STORE_TEXT=true (then the final answer text is added, never the question or chunks).
# TRACE_ENABLED=false = no tracing and no X-Trace-Id header.
TRACE_ENABLED=true
TRACE_MAX_ENTRIES=500
TRACE_TO_FILE=true
TRACES_DIR=traces
TRACE_STORE_TEXT=false
# OTLP trace export (OpenTelemetry over HTTP; blank = off). OTLP_ENDPOINT is the base URL
# ("/v1/traces" is appended); export is asynchronous and best-effort, a down collector never slows
# a request. docker compose points it at the bundled Jaeger (http://tracing:4318).
# Langfuse (cloud or self-hosted) instead of Jaeger: set
#   OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
#   OTLP_HEADERS=Authorization=Basic <base64 of public_key:secret_key>
# OTLP_HEADERS is a comma list of k=v. It holds credentials: keep it in .env only.
OTLP_ENDPOINT=
OTLP_HEADERS=
OTLP_SERVICE_NAME=askwell

# API server: bind address, port and allowed CORS origins (comma list; blank = CORS off)
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=

# Evaluation: report folder, chunks retrieved per question, judge model (blank = LLM_MODEL),
# minimum seconds between chat calls
EVAL_REPORTS_DIR=eval/reports
EVAL_RETRIEVAL_K=10
EVAL_JUDGE_MODEL=
EVAL_CHAT_INTERVAL=6.0

# Docker (docker compose up --build): api + UI, a one-shot indexer, Redis and Jaeger. The only
# required value is GEMINI_API_KEY (or OPENAI_API_KEY with LLM_PROVIDER=openai) above. Compose
# overrides API_HOST, CACHE_BACKEND, REDIS_URL and OTLP_ENDPOINT for the containers; everything
# else here applies as written. Without a key the indexer exits with a message and the api does
# not start: add the key and run `docker compose up` again.
